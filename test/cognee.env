# Settings for a throwaway Cognee on the Mac, to test the loop against.
# The model settings are the ones the cluster will use; the login is for local use only.
#
# Start it (the first start downloads about 2 GB of models into the models folder):
#   mkdir -p /tmp/memory-harness-cognee/storage /tmp/memory-harness-cognee/models
#   docker run -d --name memory-harness-cognee --env-file test/cognee.env \
#     -p 127.0.0.1:18000:8000 \
#     -v /tmp/memory-harness-cognee/storage:/cognee-storage \
#     -v /tmp/memory-harness-cognee/models:/models \
#     cognee/cognee:1.6.8
#
# Make an agent user and put its key in the environment for test/run-turn.sh:
#   TOKEN=$(curl -s -X POST http://127.0.0.1:18000/api/v1/auth/login \
#     -d 'username=admin@example.com&password=local-test-only' | jq -r .access_token)
#   export COGNEE_URL=http://127.0.0.1:18000
#   export COGNEE_API_KEY=$(curl -s -X POST "http://127.0.0.1:18000/api/v1/agents/create?name=memory-agent" \
#     -H "Authorization: Bearer $TOKEN" | jq -r .agentApiKey)
#
# It uses about 5 GiB of memory while running:  docker stop memory-harness-cognee

# No LLM: a local model builds the graph, another makes the search vectors.
GRAPH_EXTRACTOR=gliner
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_COMPLETION_TOKENS=512
AUTO_FEEDBACK=false
# One store per user and dataset, and a key on every request.
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true
# Cognee refuses an address ending in .local.
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=local-test-only
HF_HOME=/models
